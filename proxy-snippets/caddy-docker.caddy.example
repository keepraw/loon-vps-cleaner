# Copy this site block into your existing Dockerized Caddy configuration.
# Caddy must be attached to the same external Docker network selected at setup.
__DOMAIN__ {
  encode zstd gzip

  @feed path /loon/*
  handle @feed {
    header Cache-Control "private, no-store"
    reverse_proxy loon-vps-cleaner-registry:8000
  }

  @admin path /manager /manager/* /api/* /static/*
  handle @admin {
    basic_auth {
      __ADMIN_USER__ __ADMIN_HASH__
    }
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "no-referrer"
    header X-Frame-Options "DENY"
    reverse_proxy loon-vps-cleaner-registry:8000
  }

  handle {
    respond "Not found" 404
  }
}
