# Include these locations inside the existing TLS server block for __DOMAIN__.
# setup.sh replaces the placeholders in the generated copy.
location ^~ /loon/ {
    add_header Cache-Control "private, no-store" always;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:__PORT__;
}

location ~ ^/(manager|api|static)(/|$) {
    auth_basic "Loon VPS Cleaner";
    auth_basic_user_file __HTPASSWD_PATH__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:__PORT__;
}

location / {
    return 404;
}
